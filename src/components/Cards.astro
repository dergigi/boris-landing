---
// FAQ
import SectionHeading from './SectionHeading.astro';

const link = (href: string, text: string) =>
  `<a href="${href}" target="_blank" rel="noopener noreferrer" class="link-inline">${text}</a>`;

const faqs = [
  {
    q: 'What is Nostr?',
    a: `Nostr is ${link('https://nostr.com/', 'an open protocol')} with a chance of working. A simple standard that defines a scalable architecture of clients and servers that can be used to spread information freely. Anyone can build on it, and anyone can use it.`,
  },
  {
    q: 'Why Boris?',
    a: `Boris is the reading app I always wanted to have. I had ${link('https://read.withboris.com/a/naddr1qvzqqqr4gupzqmjxss3dld622uu8q25gywum9qtg4w4cv4064jmg20xsac2aam5nqqxnzd3cxqmrzv3exgmr2wfesgsmew', 'this idea')} for ${link('https://read.withboris.com/a/naddr1qqsxzttkd9ekjmmw94nx7u3dvykhvctvw4jj6etwv93xcety94mk2cszyphydppzm7m554ecwq4gsgaek2qk32atse2l4t9ks57dpms4mmhfxqcyqqq823c59stcz', 'a reading app')} for a long time, and now I finally sat down and built it. The name comes from ${link('https://relay.dergigi.com/03e174145e1f410772bb8c3e79b153ac0077fe482d7006b1f0ed67a81d475bb9.png', 'a hallucinated answer')} to the question "Who invented the highlight marker?".`,
  },
  {
    q: 'What about privacy?',
    a: `Boris is a nostr client, which means that all highlights and annotations are public by default. While nostr supports private bookmarks, your highlights and annotations are public, just like your notes and posts. Boris adheres to ${link('https://nostrbook.dev/kinds/9802', 'NIP-84')} and publishes highlights and annotations to your relays.`,
  },
];
---

<section id="faq" class="scroll-mt-16 border-b border-rule">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <SectionHeading title="FAQ" />
    <dl class="grid gap-x-10 border-t border-rule md:grid-cols-3">
      {faqs.map((f) => (
        <div class="border-b border-rule py-8 md:border-b-0">
          <dt class="font-serif-reading text-2xl font-semibold tracking-tight">{f.q}</dt>
          <dd class="mt-3 text-[15px] leading-relaxed text-ink-2" set:html={f.a} />
        </div>
      ))}
    </dl>
  </div>
</section>
