---
import { NAV_LINKS, ZAPSTORE_ANDROID_URL } from '../config/links';
---

<header class="border-b border-rule">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="#" class="flex items-center no-underline" aria-label="Boris, back to top">
      <img src="/boris-logo.svg" alt="boris" width="128" height="64" class="h-11 w-auto" />
    </a>

    <div class="flex items-center gap-1 sm:gap-6">
      <ul class="hidden items-center gap-6 text-sm text-ink-2 sm:flex">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="no-underline transition-colors duration-150 hover:text-ink">{link.label}</a>
          </li>
        ))}
      </ul>
      <a
        href={ZAPSTORE_ANDROID_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 items-center rounded-lg bg-ink px-3.5 text-sm font-medium text-paper no-underline transition-opacity duration-150 hover:opacity-85"
      >
        Get the Android app
      </a>
    </div>
  </nav>
</header>
