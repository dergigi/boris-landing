---
import GetBoris from './GetBoris.astro';
---

<section class="bg-[#fde047] text-[#1c1917] [--ink-3:#7c6a12]">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-5 py-16 sm:px-8 sm:py-24 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h2 class="font-serif-reading text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        Why are you still here?
      </h2>
      <p class="mt-4 font-serif-reading text-2xl sm:text-3xl">
        You could be highlighting stuff!
      </p>
    </div>
    <GetBoris class="shrink-0" />
  </div>
</section>
