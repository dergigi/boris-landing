---
import GetBoris from './GetBoris.astro';
---

<section class="border-b border-rule">
  <div class="mx-auto flex min-h-svh w-full max-w-6xl flex-col justify-center px-5 py-16 sm:px-8 sm:py-24">
    <h2 class="font-serif-reading text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
      Why are you still here?
    </h2>
    <p class="mt-4 font-serif-reading text-2xl sm:text-3xl">
      You could be <span class="mark-mine">highlighting stuff!</span>
    </p>
    <GetBoris class="mt-10" size="md" />
  </div>
</section>
