---
import { GITHUB_URL, WEB_APP_URL, ZAPSTORE_ANDROID_URL } from '../config/links';

const groups = [
  {
    heading: 'Get Boris',
    links: [
      { href: ZAPSTORE_ANDROID_URL, label: 'Android on Zapstore', external: true },
      { href: 'https://github.com/dergigi/boris-android/releases', label: 'Android APK', external: true },
      { href: WEB_APP_URL, label: 'Web app' },
    ],
  },
  {
    heading: 'Links',
    links: [
      { href: 'https://dergigi.com/2022/12/18/a-vision-for-a-value-enabled-web/', label: 'Vision', external: true },
      { href: 'https://ants.sh/e/nevent1qqsvxtvgkg2asldpd7e6n54cceclawlqa096ma5jpkl9ee7uwy82rwqpzemhxue69uhhwmm59ejx2un8d9nkjtnrdakj7q3q9802see0gnk3vjlus0dnmfdagusqrtmsxpl5yfmkwn9uvnfnqylqxpqqqqqqz0zud5w', label: 'Help', external: true },
      { href: '#faq', label: 'FAQ' },
    ],
  },
  {
    heading: 'Code',
    links: [
      { href: GITHUB_URL, label: 'Web app repo', external: true },
      { href: 'https://github.com/dergigi/boris-android', label: 'Android repo', external: true },
      { href: `${GITHUB_URL}?tab=MIT-1-ov-file#readme`, label: 'License', external: true },
    ],
  },
  {
    heading: 'Social',
    links: [
      { href: 'https://njump.me/npub19802see0gnk3vjlus0dnmfdagusqrtmsxpl5yfmkwn9uvnfnqylqduhr0x', label: 'Njump', external: true },
      { href: 'nostr:npub19802see0gnk3vjlus0dnmfdagusqrtmsxpl5yfmkwn9uvnfnqylqduhr0x', label: 'Nostr' },
      { href: 'https://read.withboris.com/p/npub19802see0gnk3vjlus0dnmfdagusqrtmsxpl5yfmkwn9uvnfnqylqduhr0x', label: 'Blog', external: true },
    ],
  },
  {
    heading: 'About',
    links: [
      { href: 'https://dergigi.com/bio/', label: 'About me', external: true },
      { href: 'https://dergigi.com/contact/', label: 'Contact', external: true },
    ],
  },
];
---

<footer class="mt-auto">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_repeat(5,1fr)] sm:gap-6">
      <a href="#" class="w-fit no-underline" aria-label="Boris, back to top">
        <img src="/boris-logo.svg" alt="boris" width="128" height="64" class="h-14 w-auto" />
      </a>
      {groups.map((g) => (
        <div>
          <h2 class="text-xs font-medium tracking-wide text-ink-3">{g.heading}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                  class="text-ink-2 no-underline transition-colors duration-150 hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-12 text-xs text-ink-3">Free and open source under the MIT license.</p>
  </div>
</footer>
