---
import SectionHeading from './SectionHeading.astro';
import { inlineIllustration } from '../lib/illustration';

const link = (href: string, text: string) =>
  `<a href="${href}" target="_blank" rel="noopener noreferrer" class="link-inline">${text}</a>`;

const features = [
  {
    title: 'Read Anywhere',
    image: 'read-anywhere',
    body: [
      'Boris is a native Android app, built for the phone you already carry. Paste a URL, share a link from any app, or open a nostr article, and read it in peace.',
      'Boris also runs in any browser on desktop or tablet, and the web version installs as a PWA.',
    ],
  },
  {
    title: 'Distraction-Free',
    image: 'distraction-free',
    body: [
      'Boris aims to be a calm reader app with clean typography, beautiful design, and a focus on readability.',
      'Boris does not and will never have ads, trackers, paywalls, subscriptions, or any other distractions.',
    ],
  },
  {
    title: 'Airplane Mode',
    image: 'airplane-mode',
    body: [
      'Boris is offline-first by design. With a local relay you can read, create highlights, and browse your library without a network. When in <em>Airplane Mode</em> or offline, Boris will store changes locally and sync later.',
      `Run ${link('https://github.com/greenart7c3/Citrine', 'Citrine')} on your phone or ${link('https://github.com/CodyTseng/nostr-relay-tray', 'nostr-relay-tray')} on your desktop to use Boris offline.`,
    ],
  },
  {
    title: 'Social Highlights',
    image: 'swarm-highlights',
    body: [
      'Discover highlights from your friends and others, as well as long-form content from the nostrverse.',
      '"Swarm highlights" help you discover the most interesting passages, while the explore page will show you nostr-native long-form content.',
    ],
  },
  {
    title: 'Lists, Libraries, and More',
    image: 'reading-list',
    body: [
      'Boris turns your bookmarks into a focused reading queue. It supports public and private bookmarks, RSS feeds, as well as regular web URLs.',
      'Keep track of reading progress, jump to specific passages, and mark articles (and other stuff) as read.',
    ],
  },
  {
    title: 'Zap Splits',
    image: 'zap-splits',
    body: [
      'When creating highlights, Boris automatically sets up zap splits so that value flows to authors and curators alike.',
      'You have full control over all zap splits. You can change the splits as you wish or use one of the predefined presets.',
    ],
  },
  {
    title: 'Comforting Colors',
    image: 'comforting-colors',
    body: [
      'Read during the day or late at night. Boris has multiple light and dark themes tuned for long reads. Choose fonts and sizes, highlight styles, and pick colors that fit your personal choice.',
    ],
  },
  {
    title: 'Peace of Mind',
    image: 'peace-of-mind',
    body: [
      'No signups, no accounts, no lock-ins. Your data lives on Nostr, and Boris renders it locally through an opinionated lens. Boris never holds your key; Amber or a bunker signs for you.',
      'You will never be locked out, no matter what. Boris will never rugpull you, because it can\'t rugpull you. You are in full control of your data. All the highlights, bookmarks, and reading metadata you create will forever be your own.',
    ],
  },
  {
    title: 'Free as in Freedom',
    image: 'free-forever',
    body: [
      'Boris is free and open-source and always will be. You can do with it what you want. Fork it, modify it, contribute to it, or just use it as is.',
      `Boris is free as in beer too, but you can send me sats if you appreciate my work. ${link('https://dergigi.com/support/', '#v4v')}`,
    ],
  },
];

// One strip per theme, in the order you would meet the screens: arrive,
// find something, read it, mark it, tune it, look back at what you've read.
const shots = {
  light: [
    { src: '/android-read-1.webp', alt: 'Reading an essay in light mode, with title, reading time, and highlight count' },
    { src: '/android-read-2.webp', alt: 'An essay with a passage highlighted in orange by a friend' },
    { src: '/android-read-4.webp', alt: 'Reading with your own yellow highlights and purple ones from the nostrverse' },
    { src: '/android-read-3.webp', alt: 'Reading with text-to-speech playing, the current passage highlighted' },
    { src: '/android-settings-2.webp', alt: 'Highlight settings: pick a color for your own, your friends\', and nostrverse highlights' },
    { src: '/android-settings-1.webp', alt: 'Settings: appearance, reading, text-to-speech, media, highlights, zap splits' },
    { src: '/android-settings-feeds.webp', alt: 'Feeds settings: default view, scope, and your RSS feeds' },
    { src: '/android-settings-3.webp', alt: 'Airplane mode settings: local relay, offline bookmarks and highlights' },
    { src: '/android-settings-4.webp', alt: 'About Boris: tutorial, vision, support, source code, author' },
  ],
  dark: [
    { src: '/android-1-home.webp', alt: 'Home screen: recently highlighted by others, most highlighted this week, random unreads' },
    { src: '/android-2-library.webp', alt: 'Your library: private, public, and web bookmarks in one reading list' },
    { src: '/android-3-feeds.webp', alt: 'Feeds: highlights, writings, and RSS from people you follow' },
    { src: '/android-4-search.webp', alt: 'Searching highlights across the nostrverse for a word' },
    { src: '/android-search-highlight.webp', alt: 'A search result with the matching passages highlighted' },
    { src: '/android-dark-1.webp', alt: 'Reading an essay in dark mode' },
    { src: '/android-reader-art.webp', alt: 'An article with cover art' },
    { src: '/android-dark-4.webp', alt: 'Reading with highlights from you, your friends, and the nostrverse layered on the text' },
    { src: '/android-dark-2.webp', alt: 'The highlights panel: a passage marked by you and by others' },
    { src: '/android-settings-reading.webp', alt: 'Reading settings: font, size, alignment, and highlight colors with a live preview' },
    { src: '/android-profile-highlights.webp', alt: 'A profile with its highlights, writings, and bookmarks' },
    { src: '/android-5-you.webp', alt: 'Your profile: recent activity and what you have been reading' },
  ],
};

---

<section id="features" class="scroll-mt-16 border-b border-rule">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <SectionHeading title="Features">
      Everything a reading app needs, and none of the things that make reading worse.
    </SectionHeading>

    <ul class="border-t border-rule">
      {features.map((f, i) => (
        <li class="group grid items-center gap-10 border-b border-rule py-16 md:grid-cols-2 md:gap-16 md:py-24">
          <div class:list={['max-w-md', i % 2 === 1 && 'md:order-last']}>
            <h3 class="font-serif-reading text-3xl font-semibold tracking-tight">{f.title}</h3>
            <div class="mt-5 space-y-4 text-base leading-relaxed text-ink-2">
              {f.body.map((p) => <p set:html={p} />)}
            </div>
          </div>
          <Fragment
            set:html={inlineIllustration(
              f.image,
              'mx-auto h-56 w-auto max-w-full transition-[filter] duration-300 ease-out md:h-72 dark:invert dark:hue-rotate-180 [@media(hover:hover)]:grayscale [@media(hover:hover)]:group-hover:grayscale-0',
            )}
          />
        </li>
      ))}
    </ul>
  </div>

  {Object.entries(shots).map(([theme, list]) => (
    <div
      class:list={['marquee pb-16 sm:pb-24', theme === 'dark' ? 'hidden dark:block' : 'dark:hidden']}
      style={`--marquee-duration: ${list.length * 6}s`}
    >
      <ul aria-label="Screens from the Android app">
        {[false, true].map((copy) =>
          list.map((s) => (
            <li class="phone fade-bottom mr-5 aspect-[2/3] w-64 shrink-0 sm:w-72" aria-hidden={copy || undefined}>
              <img src={s.src} alt={copy ? '' : s.alt} width="720" height="1462" loading="lazy" decoding="async" />
            </li>
          )),
        )}
      </ul>
    </div>
  ))}
</section>

<script>
  // Draw each illustration in once it scrolls into view. Without JS the
  // shapes are simply visible, since `illo-ready` is what hides them.
  const illos = document.querySelectorAll<SVGElement>('svg.illo');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-inview');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.4 },
    );
    for (const svg of illos) {
      svg.classList.add('illo-ready');
      io.observe(svg);
    }
  }
</script>
