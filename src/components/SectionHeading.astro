---
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
---

<div class="mb-10 flex flex-col gap-4 sm:mb-14 sm:flex-row sm:items-end sm:justify-between">
  <h2 id={id} class="font-serif-reading text-3xl font-semibold tracking-tight sm:text-4xl">
    <slot name="title">{title}</slot>
  </h2>
  {Astro.slots.has('default') && (
    <p class="max-w-md text-base leading-relaxed text-ink-2">
      <slot />
    </p>
  )}
</div>
