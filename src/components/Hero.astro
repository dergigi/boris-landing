---
import GetBoris from './GetBoris.astro';

const levels = [
  { mark: 'mark-mine', label: 'you' },
  { mark: 'mark-friends', label: 'friends' },
  { mark: 'mark-nostrverse', label: 'nostrverse' },
];
---

<section class="border-b border-rule">
  <div class="mx-auto grid max-w-6xl gap-x-12 px-5 pt-14 sm:px-8 sm:pt-20 lg:grid-cols-12 lg:pt-24">
    <div class="pb-14 lg:col-span-7 lg:pb-24">
      <h1 class="font-serif-reading text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.02em] sm:text-6xl lg:text-[4.25rem]">
        Hello! I'm Boris.<br />I like to read.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2 sm:text-xl">
        I'm a nostr-native app designed for reading and
        <span class="mark-mine">highlighting</span>.
      </p>

      <GetBoris class="mt-8" />

      <figure class="mt-14 max-w-2xl border-t border-rule pt-8 sm:mt-16">
        <blockquote class="font-serif-reading text-xl leading-[1.55] sm:text-[1.75rem]">
          <p>
            Information does not just want to be free,
            <span class="mark-mine mark-draw" style="--mark-delay: 0.3s">it longs to be free</span>.
            <span class="mark-friends mark-draw" style="--mark-delay: 0.7s">Information expands to fill the available storage space.</span>
            Information is Rumor's younger, stronger cousin; Information is fleeter of foot,
            <span class="mark-nostrverse mark-draw" style="--mark-delay: 1.1s">has more eyes, knows more, and understands less than Rumor</span>.
          </p>
        </blockquote>
        <figcaption class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-2">
          <span>Eric Hughes, <cite class="not-italic">A Cypherpunk's Manifesto</cite></span>
          <ul class="flex items-center gap-4" aria-label="Highlight levels">
            {levels.map((l) => (
              <li class="flex items-center gap-1.5">
                <span class:list={['inline-block h-3 w-3 rounded-[3px]', l.mark]} aria-hidden="true"></span>
                {l.label}
              </li>
            ))}
          </ul>
        </figcaption>
      </figure>
    </div>

    <div class="relative h-[22rem] overflow-hidden sm:h-[28rem] lg:col-span-5 lg:h-auto lg:self-stretch">
      <div class="phone absolute inset-x-0 top-0 mx-auto w-full max-w-[20rem] lg:mx-0 lg:ml-auto lg:max-w-[24rem]">
        <img
          src="/android-read-2.webp"
          width="720"
          height="1462"
          alt="Boris on Android in light mode: an essay in serif type with a passage highlighted in orange by a friend"
          class="dark:hidden"
          fetchpriority="high"
        />
        <img
          src="/android-dark-2.webp"
          width="720"
          height="1462"
          alt="Boris on Android in dark mode: the highlights panel showing the same passage marked by you and by others in the nostrverse"
          class="hidden dark:block"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
