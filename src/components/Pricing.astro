---
import SectionHeading from './SectionHeading.astro';
import { NOSTR_PROFILE_URI } from '../config/links';

const tiers = [
  {
    name: 'Free',
    amount: '0 sats',
    perks: ['All the features', 'Open-source forever', 'Full freedom'],
    featured: false,
  },
  {
    name: 'Support Boris',
    amount: '2.1k sats',
    perks: ['Still all the features', 'Feel great about it', 'Show up as a supporter', 'Marvel at your avatar'],
    featured: true,
  },
  {
    name: 'Legend',
    amount: '69,420 sats',
    perks: ['Fantastic numerology', 'Massive bragging rights', 'Flames around your avatar'],
    featured: false,
  },
];
---

<section id="zaps" class="scroll-mt-16 border-b border-rule">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <SectionHeading title="Zaps">
      <Fragment slot="title"><s class="text-ink-3 decoration-1">Pricing</s> Zaps</Fragment>
      Boris is a labor of love and is developed by
      <a href="https://dergigi.com" target="_blank" rel="noopener noreferrer" class="link-inline">one guy</a>.
      If you can't send zaps, send memes. Or things to read.
    </SectionHeading>

    <ul class="grid border-t border-rule sm:grid-cols-3">
      {tiers.map((t) => (
        <li class:list={['flex flex-col border-b border-rule py-8 sm:border-b-0 sm:border-r sm:px-8 sm:first:pl-0 sm:last:border-r-0 sm:last:pr-0', t.featured && 'sm:bg-paper-2']}>
          <h3 class="font-serif-reading text-2xl font-semibold tracking-tight">{t.name}</h3>
          <p class="mt-2 text-3xl font-medium tabular-nums tracking-tight">
            {t.featured ? <span class="mark-mine">{t.amount}</span> : t.amount}
          </p>
          <ul class="mt-6 space-y-2 text-[15px] leading-relaxed text-ink-2">
            {t.perks.map((p) => <li>{p}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-col gap-4 border-t border-rule pt-10 sm:mt-14 sm:flex-row sm:items-center sm:gap-6">
      <a
        href={NOSTR_PROFILE_URI}
        class="inline-flex h-12 w-fit items-center rounded-lg bg-ink px-6 text-base font-medium text-paper no-underline transition-opacity duration-150 hover:opacity-85"
      >
        Zap Boris
      </a>
      <p class="text-sm leading-relaxed text-ink-2">
        Opens the Boris profile in your nostr client.<br class="hidden sm:block" />
        Don't have one yet? <a href="https://nostr-resources.com/#clients" target="_blank" rel="noopener noreferrer" class="link-inline">Pick a client</a>.
      </p>
    </div>
  </div>
</section>
