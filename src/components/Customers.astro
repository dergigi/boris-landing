---
// Credits: projects and ideas Boris builds on.
const giants = [
  { href: 'https://github.com/hzrd149/applesauce', label: 'Applesauce', img: '/applesauce.svg' },
  { href: 'https://github.com/greenart7c3/Citrine', label: 'Citrine', img: '/citrine.png' },
  { href: 'https://highlighter.com/', label: 'Highlighter', img: '/highlighter.svg', imgDark: '/highlighter-dark.svg' },
  { href: 'https://nostrbook.dev/kinds/9802', label: 'Kind 9802', img: '/kind9802.webp' },
  { href: 'https://chromewebstore.google.com/detail/lantern/jjoijlenmgefkaeiomoaelcljfibpcgh', label: 'Lantern', img: '/lantern.png' },
  { href: 'https://github.com/nostr-protocol/nips/blob/master/23.md', label: 'NIP-23', img: '/nostr.jpg' },
  { href: 'https://read.withboris.com/a/naddr1qvzqqqr4gupzqmjxss3dld622uu8q25gywum9qtg4w4cv4064jmg20xsac2aam5nqqgxc6t8dp6xu6twvukhqunfwdkhx9800nj', label: 'Prism', img: '/prism.svg' },
  { href: 'https://read.withboris.com/a/naddr1qvzqqqr4gupzqmjxss3dld622uu8q25gywum9qtg4w4cv4064jmg20xsac2aam5nqqxnzd3cxqmrzv3exgmr2wfesgsmew', label: 'Purple Text', img: '/ostrich-head.jpg' },
];
---

<section class="border-b border-rule">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <h2 class="text-sm font-medium text-ink-3">Standing on the shoulders of giants</h2>
    <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
      {giants.map((g) => (
        <li>
          <a
            href={g.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 text-sm font-medium text-ink-2 no-underline transition-colors duration-150 hover:text-ink"
          >
            <img
              src={g.img}
              alt=""
              width="28"
              height="28"
              loading="lazy"
              class:list={['h-7 w-7 rounded-md object-contain grayscale transition-[filter] duration-200 group-hover:grayscale-0', g.imgDark && 'dark:hidden']}
            />
            {g.imgDark && (
              <img
                src={g.imgDark}
                alt=""
                width="28"
                height="28"
                loading="lazy"
                class="hidden h-7 w-7 rounded-md object-contain grayscale transition-[filter] duration-200 group-hover:grayscale-0 dark:block"
              />
            )}
            {g.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
